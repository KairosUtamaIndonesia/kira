{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "proseWrap": "preserve",
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "out/**",
    "release/**",
    "coverage/**",
    ".agents/**",
    ".pi/**",
    "packages/theme/src/built/**"
  ]
}
