{
  "name": "@kira/theme",
  "version": "0.1.0",
  "private": true,
  "description": "Kira's theme: what every surface of the product looks like",
  "type": "module",
  "exports": {
    ".": "./src/index.tsx"
  },
  "scripts": {
    "theme:build": "astryx theme build ./src/kiraTheme.ts -o ./src/built/kira.css",
    "theme:check": "astryx theme build ./src/kiraTheme.ts -o ./src/built/kira.css --check"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.2",
    "@astryxdesign/theme-neutral": "^0.6.2",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.2",
    "@types/react": "^19.3.0"
  }
}
