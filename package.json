{
  "name": "foundry",
  "version": "0.1.0",
  "private": true,
  "description": "Foundry desktop agent",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-pi-config-dir.mjs && node apps/desktop/node_modules/electron/install.js",
    "dev:desktop": "bun run --cwd apps/desktop dev -- --remoteDebuggingPort 1987",
    "dev:admin": "bun run --cwd apps/admin dev",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:cliproxyapi": "bun run scripts/dev-cliproxyapi.ts",
    "dev:upstream": "bun run apps/server/src/test-support/fake-upstream.ts",
    "build:desktop": "bun run --cwd apps/desktop build",
    "build:admin": "bun run --cwd apps/admin build",
    "package:desktop": "bun run --cwd apps/desktop package",
    "dist:desktop": "bun run --cwd apps/desktop dist",
    "test": "bun run --cwd apps/desktop test && bun run --cwd apps/server test && bun run --cwd apps/admin test",
    "typecheck": "bun run --cwd apps/desktop typecheck && bun run --cwd apps/server typecheck && bun run --cwd apps/admin typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=22.19.0"
  },
  "trustedDependencies": [
    "electron"
  ]
}
