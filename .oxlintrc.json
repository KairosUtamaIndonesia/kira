{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "warn",
    "typescript/no-unused-vars": "error",
    "react/jsx-key": "error",
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "out/**",
    "release/**",
    ".agents/**",
    ".pi/**",
    "packages/theme/src/built/**"
  ]
}
