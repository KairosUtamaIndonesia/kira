# Copy to .env and fill in. `.env` is gitignored; this file is not, so it must
# never hold a real secret.
#
# Bun loads .env automatically when a command runs from apps/server.
# Every variable is validated at boot by src/config.ts, and the server refuses
# to start until they are all correct — it reports every problem in one run.

# --- Entra ID -----------------------------------------------------------------
# From the app registration in Entra ID. Kira is a confidential client, so it
# holds the secret and the desktop never sees one.
#
# Register it as a Web platform (not SPA, not public client) with the redirect
# URI below, where the host matches KIRA_BASE_URL:
#
#     http://localhost:4100/api/auth/callback/microsoft
#
KIRA_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
KIRA_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
KIRA_ENTRA_CLIENT_SECRET=

# --- Kira ------------------------------------------------------------------
# Signs session cookies. Generate one with: openssl rand -base64 48
KIRA_AUTH_SECRET=

# The server's own address. Must match the redirect URI registered above.
KIRA_BASE_URL=http://localhost:4100

# Optional. Defaults to the development database `compose.yaml` runs, on port 5439.
# A deployed server sets this, and there it is a secret: the URL carries the password.
# KIRA_DATABASE_URL=postgres://kira:secret@db.internal:5432/kira

# --- GitHub App --------------------------------------------------------------
# Optional. Set these to let an admin install the App from Settings → Git hosts.
# Create the App at github.com/settings/apps, then point its Webhook URL at
# ${KIRA_BASE_URL}/api/webhooks/github and its Setup URL at
# ${KIRA_BASE_URL}/api/git/github/setup (with "Redirect on update" on).
#
# SLUG is the App's URL slug; APP_ID is the App ID (or Client ID).
# The private key is the .pem GitHub generates under "Private keys"; write its
# contents as ONE line with newlines escaped as \n.
#
# WEBHOOK_SECRET signs the App install state and is the secret GitHub sends on
# /api/webhooks/github — set the same value in the App's Webhook secret field.
# KIRA_GITHUB_APP_SLUG=
# KIRA_GITHUB_APP_ID=
# KIRA_GITHUB_APP_PRIVATE_KEY=
# KIRA_GITHUB_WEBHOOK_SECRET=

# Optional. Seals the webhook secret of a token-based host (Forgejo, Gitea, GitLab,
# or GitHub connected by personal access token). Base64 of 32 random bytes:
#   openssl rand -base64 32
# KIRA_GIT_SECRET_KEY=
