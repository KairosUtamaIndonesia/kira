# Copy to .env and fill in. `.env` is gitignored; this file is not, so it must
# never hold a real secret.
#
# Bun loads .env automatically when a command runs from apps/server.
# Every variable is validated at boot by src/config.ts, and the server refuses
# to start until they are all correct — it reports every problem in one run.

# --- Entra ID -----------------------------------------------------------------
# From the app registration in Entra ID. Foundry is a confidential client, so it
# holds the secret and the desktop never sees one.
#
# Register it as a Web platform (not SPA, not public client) with the redirect
# URI below, where the host matches FOUNDRY_BASE_URL:
#
#     http://localhost:4100/api/auth/callback/microsoft
#
FOUNDRY_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
FOUNDRY_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
FOUNDRY_ENTRA_CLIENT_SECRET=

# --- Foundry ------------------------------------------------------------------
# Signs session cookies. Generate one with: openssl rand -base64 48
FOUNDRY_AUTH_SECRET=

# The server's own address. Must match the redirect URI registered above.
FOUNDRY_BASE_URL=http://localhost:4100

# Optional. Defaults to the development database `compose.yaml` runs, on port 5439.
# A deployed server sets this, and there it is a secret: the URL carries the password.
# FOUNDRY_DATABASE_URL=postgres://foundry:secret@db.internal:5432/foundry
