{
  "name": "@kira/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Kira desktop application",
  "main": "./out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "package": "bun run build && electron-builder --dir",
    "dist": "bun run build && electron-builder"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.20",
    "@astryxdesign/core": "^0.6.2",
    "@astryxdesign/theme-neutral": "^0.6.2",
    "@better-auth/electron": "1.7.5",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@elysiajs/eden": "^1.4.9",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@kira/theme": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "@stylexjs/stylex": "^0.19.1",
    "better-auth": "1.7.5",
    "electron-updater": "^6.6.2",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-git": "^3.36.0",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@kira/server": "workspace:*",
    "@stylexjs/rollup-plugin": "0.19.1",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "material-icon-theme": "^5.38.1",
    "vite": "^7.3.6"
  }
}
